{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter-package-v5.1.schema.json",
  "type": "object",
  "required": ["package_version", "chapter", "base_repository", "integration", "canonical", "package", "files", "validation", "ids", "limitations"],
  "properties": {
    "package_version": {"const": 1},
    "chapter": {"type": "object", "required": ["id", "exam", "part", "number", "slug", "title"], "properties": {"id": {"type": "string", "pattern": "^RHCSA-[0-9]{2}$"}, "exam": {"const": "RHCSA"}, "part": {"type": ["integer", "string"]}, "number": {"type": "integer"}, "slug": {"type": "string"}, "title": {"type": "string"}}, "additionalProperties": false},
    "base_repository": {"type": "object", "required": ["url", "branch", "commit", "verification"], "properties": {"url": {"type": "string"}, "branch": {"type": "string"}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "verification": {"enum": ["verified", "unavailable"]}, "verified_at": {"type": "string"}, "previous_recorded_commit": {"type": "string"}}, "additionalProperties": false},
    "integration": {"type": "object", "required": ["head", "method"], "properties": {"head": {"type": "string"}, "method": {"enum": ["three_way", "fast_forward_content", "manual_resolution"]}}, "additionalProperties": false},
    "canonical": {"type": "object", "required": ["lecture", "anki"], "properties": {"lecture": {"type": "string"}, "anki": {"type": "string"}}, "additionalProperties": false},
    "package": {"type": "object", "required": ["version", "status"], "properties": {"version": {"const": "5.1"}, "status": {"const": "content_frozen_for_integration"}}},
    "files": {"type": "object", "required": ["lecture", "review_pdf", "anki", "preview", "summary", "anki_impact", "source_map", "structure_report", "visual_qa", "qa_report", "revision_notes", "integration_note"], "additionalProperties": {"$ref": "#/$defs/file"}},
    "validation": {"type": "object", "required": ["mode", "live_test", "lecture_checked", "anki_checked", "pdf_rendered"]},
    "ids": {"type": "object", "required": ["section_ids_preserved", "anki_ids_preserved", "added", "modified", "disabled"]},
    "limitations": {"type": "array"},
    "extensions": {"type": "object"}
  },
  "additionalProperties": false,
  "$defs": {"file": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}}
}
